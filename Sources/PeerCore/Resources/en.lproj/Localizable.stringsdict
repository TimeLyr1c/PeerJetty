<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>receive.completed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Received %#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item</string>
			<key>other</key>
			<string>%ld items</string>
		</dict>
	</dict>
	<key>receive.notification_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Received %#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item</string>
			<key>other</key>
			<string>%ld items</string>
		</dict>
	</dict>
	<key>receive.open_failures</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@saved@ saved; could not open %#@failed@. View them in Finder</string>
		<key>failed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item</string>
			<key>other</key>
			<string>%ld items</string>
		</dict>
		<key>saved</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item</string>
			<key>other</key>
			<string>%ld items</string>
		</dict>
	</dict>
	<key>receive.partial_error</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$@ (%1$#@items@ saved)</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item</string>
			<key>other</key>
			<string>%ld items</string>
		</dict>
	</dict>
	<key>receive.saved</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@ saved; files kept closed</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item</string>
			<key>other</key>
			<string>%ld items</string>
		</dict>
	</dict>
	<key>receive.saved_open</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@ saved; opening requested</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item</string>
			<key>other</key>
			<string>%ld items</string>
		</dict>
	</dict>
</dict>
</plist>
